$scope module tb_encoding $end
$var reg 1 ! clk $end
$var reg 1 " rst_n $end
$var integer 32 # err $end
$var integer 32 $ i $end
$var reg 16 % coeff_sign [15:0] $end
$var wire 1 & sign $end
$var wire 16 ' abs_value [15:0] $end
$var reg 16 ( abs_in [15:0] $end
$var wire 7 ) low7 [6:0] $end
$var wire 9 * high [8:0] $end
$var reg 1 + unary_start $end
$var reg 9 , unary_high [8:0] $end
$var wire 1 - unary_busy $end
$var wire 1 . unary_out_valid $end
$var wire 1 / unary_out_bit $end
$var wire 1 0 unary_done $end
$var reg 1 1 pack_clear $end
$var reg 1 2 pack_bit_valid $end
$var reg 1 3 pack_bit_in $end
$var reg 1 4 pack_flush $end
$var wire 1 5 pack_byte_valid $end
$var wire 8 6 pack_byte_out [7:0] $end
$var wire 3 7 pack_bit_count [2:0] $end
$var reg 1 8 wrap_start $end
$var reg 16 9 wrap_coeff [15:0] $end
$var reg 1 : wrap_last_coeff $end
$var reg 1 ; wrap_clear $end
$var wire 1 < wrap_busy $end
$var wire 1 = wrap_coeff_done $end
$var wire 1 > wrap_byte_valid $end
$var wire 8 ? wrap_byte_out [7:0] $end

$scope task check_bool $end
$var reg 512 @ name [511:0] $end
$var reg 1 A got $end
$var reg 1 B exp $end
$upscope $end


$scope task check_u16 $end
$var reg 512 C name [511:0] $end
$var reg 16 D got [15:0] $end
$var reg 16 E exp [15:0] $end
$upscope $end


$scope task check_u9 $end
