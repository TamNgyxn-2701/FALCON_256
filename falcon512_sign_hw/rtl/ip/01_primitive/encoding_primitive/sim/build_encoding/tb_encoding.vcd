$var reg 9 G got [8:0] $end
$var reg 9 H exp [8:0] $end
$upscope $end


$scope task check_u8 $end
$var reg 512 I name [511:0] $end
$var reg 8 J got [7:0] $end
$var reg 8 K exp [7:0] $end
$upscope $end


$scope task reset_all $end
$upscope $end


$scope task clear_packer $end
$upscope $end


$scope task send_pack_bit $end
$var reg 1 L bit_value $end
$upscope $end


$scope task flush_packer $end
$upscope $end


$scope task test_unary $end
$var reg 9 M high_value [8:0] $end
$var integer 32 N bit_index $end
$var integer 32 O cycle_count $end
$var reg 1 P expected_bit $end
$var reg 1 Q done_seen $end
$upscope $end


$scope task clear_wrapper $end
$upscope $end


$scope task test_wrapper_coeff $end
$var reg 16 R coeff_value [15:0] $end
$var reg 8 S exp_byte0 [7:0] $end
$var reg 8 T exp_byte1 [7:0] $end
$var integer 32 U exp_count $end
$var integer 32 V byte_count $end
$var integer 32 W cycle_count $end
$var reg 1 X done_seen $end
$upscope $end


$scope module u_sign_bit $end
$var wire 16 Y coeff [15:0] $end
$var wire 1 & sign $end
$var wire 16 ' abs_value [15:0] $end
$var wire 1 Z is_negative $end
$var wire 1 [ is_zero $end
$upscope $end


$scope module u_low7_encoder $end
$var wire 16 \ abs_value [15:0] $end
$var wire 7 ) low7 [6:0] $end
$var wire 9 * high [8:0] $end
$upscope $end


$scope module u_unary_encoder $end
$var wire 1 ] clk $end
$var wire 1 ^ rst_n $end
$var wire 1 _ start $end
$var wire 9 ` high [8:0] $end
