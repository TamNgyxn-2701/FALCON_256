$var wire 16 "$ abs_value [15:0] $end
$var wire 7 "% low7 [6:0] $end
$var wire 9 "& high [8:0] $end
$var wire 1 "' unary_busy $end
$var wire 1 "( unary_out_valid $end
$var wire 1 ") unary_out_bit $end
$var wire 1 "* unary_done $end
$var wire 3 "+ pack_bit_count [2:0] $end

$scope module u_sign_bit $end
$var wire 16 ", coeff [15:0] $end
$var wire 1 "# sign $end
$var wire 16 "$ abs_value [15:0] $end
